DB_URI=mongodb://localhost:27017/
DB_NAME=payli
NODE_ENV=development
PORT=3000
PAYMENT_GATEWAY_URI=https://pay.payli.to
SERVICE_FEE=
ALCHEMY_API_KEY=

# Optional. Absolute path to the main log file. When set, the app ALSO writes a
# FATAL-only sibling next to it (e.g. /var/log/payli/app.log -> app.fatal.log) so
# crashes are easy to find. Leave unset in local dev to log to stdout only.
LOG_FILE_PATH=

# Used by docker compose (not the app directly) to build LOG_FILE_PATH and pick
# the host log directory. Defaults if unset: LOG_FILENAME=app.log, LOG_DIRNAME=./storage
LOG_FILENAME=app.log
LOG_DIRNAME=./storage
